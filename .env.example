# Generate both values locally. Never commit the real .env file.
# Keep both values inside single quotes.
# Werkzeug password hashes contain $ characters. Quoting prevents Docker
# Compose from interpreting parts of the hash before it reaches the container.

SECRET_KEY='replace-with-random-64-character-hex-value'
ADMIN_PASSWORD_HASH='replace-with-a-werkzeug-password-hash'

# Network binding. The secure default remains localhost only.
HOST_BIND_IP='127.0.0.1'
HOST_PORT='8282'
